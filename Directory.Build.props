<Project>
  <!--
  Language, nullability and analysis for every C# project (C-0010 sections 1 and 2).
  Code-style rules that .editorconfig sets to warning fail the build too, because the
  format check alone cannot fix or report naming violations.
  -->
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
  Restore from the committed lock files (C-0009 section 2), with the package source that
  eng/nuget.config pins. NuGet audits every package, direct or transitive; with warnings as
  errors, a new advisory fails the restore, and the package is then updated in a reviewed
  change. CI never rewrites a lock file.
  -->
  <PropertyGroup>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)eng/nuget.config</RestoreConfigFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(GITHUB_ACTIONS)' == 'true'">true</RestoreLockedMode>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <!-- Reproducible output in CI, where GitHub Actions sets GITHUB_ACTIONS (C-0009 section 6). -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
