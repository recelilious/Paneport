<Project>
  <!--
  Central package management (C-0009 section 2). A package is added here only after the
  register in C-0003 section 6 covers it and every package it brings in.
  docs/design/solution-and-build.md describes how to add or update one.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.iOS" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <!--
  The MVVM source generators for the view models (C-0010 section 2). 8.4.1 was the first
  release whose generators accept partial properties under C# 14 without the preview
  language version.
  -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!--
  The Steam service (C-0007) and the packages that SteamKit2's brings in, which C-0003 1.7
  registers. 4.0.0-Beta.2 is the first release that serializes Steam's messages through a
  compile-time protobuf-net model instead of reflection and emitted code, which full ahead-of-time
  compilation on the device needs (docs/design/steam-service.md). protobuf-net is referenced and
  pinned explicitly, so that SteamKit2's version range cannot move it
  (avalonia_ui_layer.md section 3.4).
  -->
  <ItemGroup>
    <PackageVersion Include="SteamKit2" Version="4.0.0-Beta.2" />
    <PackageVersion Include="protobuf-net" Version="3.4.40" />
  </ItemGroup>

  <!-- The QR code of the Steam sign-in, plan decision D13 (C-0003 1.7). -->
  <ItemGroup>
    <PackageVersion Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
  </ItemGroup>

  <!--
  Test libraries. Avalonia.Headless.XUnit 12.1.4 is built against xunit.v3 3.2.2, so
  xunit.v3 moves only together with it.
  -->
  <ItemGroup>
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>
