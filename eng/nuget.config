<configuration>
  <!--
  Every restore uses this file instead of the machine's own NuGet configuration
  (Directory.Build.props sets RestoreConfigFile), so that every clone and every CI run
  takes packages from the same single source.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
