<Project Sdk="Microsoft.NET.Sdk">
  <!-- A console executable, so that a run from a terminal shows Avalonia's errors there. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paneport.Core\Paneport.Core.csproj" />
    <ProjectReference Include="..\Paneport.Steam\Paneport.Steam.csproj" />
    <ProjectReference Include="..\Paneport.UI\Paneport.UI.csproj" />
  </ItemGroup>

  <!--
  The snapshot of the compatibility database, copied next to the program as the iOS build
  bundles it (C-0009 section 4). LocalFolders.cs names the folder.
  -->
  <ItemGroup>
    <None Include="..\..\compat\**\*.json" LinkBase="compat" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
