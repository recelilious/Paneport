<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paneport.Core.ViewModels"
             x:Class="Paneport.UI.Views.DiagnosticsPage"
             x:DataType="vm:DiagnosticsViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="16">
      <Grid Classes="facts" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Classes="label" Text="Host" />
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HostName}" TextWrapping="Wrap" />

        <TextBlock Grid.Row="1" Classes="label" Text="Host ABI version" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AbiVersion}" />

        <TextBlock Grid.Row="2" Classes="label" Text="Memory limit" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MemoryLimit}" />

        <TextBlock Grid.Row="3" Classes="label" Text="Available memory" />
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AvailableMemory}" />

        <TextBlock Grid.Row="4" Classes="label" Text="Current footprint" />
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Footprint}" />

        <TextBlock Grid.Row="5" Classes="label" Text="Game Mode level" />
        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding GameModeLevel}" />
      </Grid>

      <Button HorizontalAlignment="Left" Content="Refresh" Command="{Binding RefreshCommand}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
