<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paneport.Core.ViewModels"
             x:Class="Paneport.UI.Views.MainView"
             x:DataType="vm:ShellViewModel">
  <DockPanel>
    <!--
    The entries are buttons rather than a list selection, so that choosing the marked section,
    for example Library on a title's details, opens it again.
    -->
    <Border DockPanel.Dock="Bottom" Classes="navigation">
      <ItemsControl x:Name="Navigation" ItemsSource="{Binding Sections}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NavigationEntry">
            <Button Classes="section"
                    Classes.selected="{Binding IsSelected}"
                    Content="{Binding Name}"
                    Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).OpenSectionCommand}"
                    CommandParameter="{Binding Section}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <Border DockPanel.Dock="Top" Classes="header">
      <Grid ColumnDefinitions="Auto,*">
        <Button x:Name="BackButton"
                Margin="0,0,12,0"
                Content="Back"
                Command="{Binding GoBackCommand}"
                IsVisible="{Binding CanGoBack}" />
        <TextBlock x:Name="Heading"
                   Grid.Column="1"
                   Classes="heading"
                   VerticalAlignment="Center"
                   Text="{Binding CurrentPage.Header}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding CurrentPage.Header}" />
      </Grid>
    </Border>

    <ProgressBar DockPanel.Dock="Top"
                 IsIndeterminate="True"
                 IsVisible="{Binding CurrentPage.IsLoading}" />
    <TextBlock DockPanel.Dock="Top"
               Classes="error"
               Text="{Binding CurrentPage.LoadError}"
               TextWrapping="Wrap"
               IsVisible="{Binding CurrentPage.LoadError, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <!-- App.axaml's data templates pick the page's view. -->
    <ContentControl x:Name="Page" Content="{Binding CurrentPage}" />
  </DockPanel>
</UserControl>
