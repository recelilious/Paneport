<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paneport.Core.ViewModels"
             x:Class="Paneport.UI.Views.TitleDetailsPage"
             x:DataType="vm:TitleDetailsViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="16">
      <!-- The heading may trim a long name; here it wraps, so the whole name stays readable. -->
      <TextBlock Classes="name" Text="{Binding Title.Name}" TextWrapping="Wrap" />

      <Grid Classes="facts" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Classes="label" Text="Identity" />
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Title.Identity}" />

        <TextBlock Grid.Row="1" Classes="label" Text="Source" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Title.SourceText}" />

        <TextBlock Grid.Row="2" Classes="label" Text="Install state" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Title.InstallStateText}" />

        <TextBlock Grid.Row="3" Classes="label" Text="Launch path" />
        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="2">
          <TextBlock Text="{Binding Title.LaunchPathText}" />
          <TextBlock Classes="secondary" Text="{Binding Title.LaunchPathDescription}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
