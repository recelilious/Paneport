<Project>
  <!--
  The build of the iOS app head, which Paneport.iOS.csproj and the device test flavor in
  tests/device both import, so that the two flavors differ only where the flavor sets a property
  before the import: the display name, the host build it embeds and the name of the flavor
  (docs/design/ios-app-head.md section 10). The head is on Mono, the default runtime of
  net10.0-ios (C-0010 section 1), for devices only, as arm64, with iOS 26.0 as the oldest version
  it supports (C-0001 section 2).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <UseMonoRuntime>true</UseMonoRuntime>
  </PropertyGroup>

  <!--
  The bundle identifier is recelilious's decision D3 (plan section 4.2), and the device test
  flavor shares it (D12), so that it replaces the main app on the device. Development builds take
  the version from here and the build number from CI's run number, which grows with every run;
  release versions come from tags (C-0009 section 6).
  -->
  <PropertyGroup>
    <ApplicationId>io.github.recelilious.paneport</ApplicationId>
    <ApplicationTitle Condition="'$(ApplicationTitle)' == ''">Paneport</ApplicationTitle>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(PaneportBuildNumber)' != ''">$(PaneportBuildNumber)</ApplicationVersion>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>
  </PropertyGroup>

  <!--
  Device builds compile everything ahead of time, with the interpreter off (C-0009 section 3).
  The build signs nothing: CI never holds an Apple identity (C-0009 section 5), and
  eng/mac/sign-adhoc.sh signs the app ad hoc with Entitlements.plist afterwards. The SDK picks
  up an Entitlements.plist next to the project file by itself, after this file, and then asks
  for a provisioning profile (MT7139), so an unsigned build turns that off and clears the
  property. A build on a Mac with a development profile can sign itself with
  -p:EnableCodeSigning=true.
  -->
  <PropertyGroup>
    <UseInterpreter>false</UseInterpreter>
    <EnableCodeSigning Condition="'$(EnableCodeSigning)' == ''">false</EnableCodeSigning>
    <EnableDefaultCodesignEntitlements Condition="'$(EnableCodeSigning)' != 'true'">false</EnableDefaultCodesignEntitlements>
    <CodesignEntitlements Condition="'$(EnableCodeSigning)' != 'true'"></CodesignEntitlements>
    <CodesignEntitlements Condition="'$(EnableCodeSigning)' == 'true'">$(MSBuildThisFileDirectory)Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <!--
  extended-virtual-addressing is declared only when PaneportExtendedVirtualAddressing is true
  (C-0009 section 4); the default is false, as L1 and the release expect. A signing build adds it
  to Entitlements.plist's entitlements here. An unsigned build has no entitlements of its own: the
  ad-hoc route takes the same switch as PANEPORT_EXTENDED_VIRTUAL_ADDRESSING, which the ios job
  sets once for the build, eng/mac/sign-adhoc.sh and eng/mac/check-app.sh.
  -->
  <PropertyGroup>
    <PaneportExtendedVirtualAddressing Condition="'$(PaneportExtendedVirtualAddressing)' == ''">false</PaneportExtendedVirtualAddressing>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableCodeSigning)' == 'true' And '$(PaneportExtendedVirtualAddressing)' == 'true'">
    <CustomEntitlements Include="com.apple.developer.kernel.extended-virtual-addressing" Type="Boolean" Value="true" />
  </ItemGroup>

  <!--
  The native host (C-0009 section 4): a framework that the ios job builds before the app,
  embedded with a NativeReference of kind Framework and imported as
  @rpath/paneport_host.framework/paneport_host. The main app embeds the build of the ios-device
  preset, the device test flavor the build of ios-device-test.
  -->
  <PropertyGroup>
    <PaneportHostPreset Condition="'$(PaneportHostPreset)' == ''">ios-device</PaneportHostPreset>
    <PaneportHostFramework>$(MSBuildThisFileDirectory)../../build/native/$(PaneportHostPreset)/paneport_host.framework</PaneportHostFramework>
  </PropertyGroup>

  <ItemGroup>
    <NativeReference Include="$(PaneportHostFramework)">
      <Kind>Framework</Kind>
      <SmartLink>False</SmartLink>
    </NativeReference>
  </ItemGroup>

  <!--
  The build stamp of Diagnostics (ios-app-head.md section 6), as values of the runtime's
  configuration, which AppContext.GetData reads; the trimmer of iOS builds removes every
  AssemblyMetadataAttribute, so assembly metadata would be lost (IL2045). CI passes the
  pull request's head commit as PaneportCommit, because it checks out the merge commit; a local
  build records none.
  -->
  <PropertyGroup>
    <PaneportCommit Condition="'$(PaneportCommit)' == ''">Not recorded: a local build</PaneportCommit>
    <PaneportFlavor Condition="'$(PaneportFlavor)' == ''">main app</PaneportFlavor>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Paneport.Commit" Value="$(PaneportCommit)" />
    <RuntimeHostConfigurationOption Include="Paneport.Configuration" Value="$(Configuration)" />
    <RuntimeHostConfigurationOption Include="Paneport.Interpreter" Value="$(UseInterpreter)" />
    <RuntimeHostConfigurationOption Include="Paneport.HostPreset" Value="$(PaneportHostPreset)" />
    <RuntimeHostConfigurationOption Include="Paneport.Flavor" Value="$(PaneportFlavor)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>

  <!--
  Avalonia.DesignerSupport serves only the XAML previewer of an IDE, and the app never loads it.
  The SDK keeps every assembly that is not marked trimmable whole, which makes the trimmer
  analyze all of it (IL2104); marked trimmable, it is removed with the rest of the unused code.
  -->
  <ItemGroup>
    <TrimmableAssembly Include="Avalonia.DesignerSupport" />
  </ItemGroup>

  <!--
  Avalonia.iOS is kept whole. When .NET for iOS trims an assembly with NSObject subclasses, its
  MarkNSObjectsStep preserves their members through dynamic dependencies by name, and the names
  of explicitly implemented protocol members, such as those of Avalonia's text input responder,
  do not resolve (IL2037). Those members would then be trimmed away and the keyboard's input lost.
  Copied whole, the assembly keeps every member and gets no such dependency.
  -->
  <Target Name="PaneportKeepAvaloniaIOSWhole" BeforeTargets="_ComputeManagedAssemblyToLink">
    <ItemGroup>
      <ResolvedFileToPublish Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Avalonia.iOS.dll'">
        <TrimMode>copy</TrimMode>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
  protobuf-net and protobuf-net.Core are not marked trimmable, so the SDK keeps them whole and the
  trimmer analyzes all their code, which reflects over types known only at run time. recelilious
  approved the list of their warnings in eng/trimming/ (docs/design/repository-checks.md
  section 7). The SDK passes each file of _ILLinkSuppressions, an internal item of its own, to the
  trimmer as link attributes; if the item ever goes, the warnings come back and fail the build.
  TrimmerSingleWarn=false on the two assemblies, the metadata that the SDK also sets on project
  references, lists each of their warnings by code and method instead of one IL2104 per assembly,
  so a warning outside the list names itself.
  -->
  <ItemGroup>
    <_ILLinkSuppressions Include="$(MSBuildThisFileDirectory)../../eng/trimming/*.xml" />
  </ItemGroup>

  <!--
  The runtime's switch System.ComponentModel.DefaultValueAttribute.IsSupported, off as in every
  other trimmed app. The SDK turns it off only when PublishTrimmed is true as the project is read,
  and .NET for iOS sets PublishTrimmed later, in a target, so on iOS the switch stays unset. Unset,
  the trimmer keeps the attribute's conversion of a string through a TypeConverter, which needs
  unreferenced code (IL2026 inside System.Private.CoreLib), for SteamKit2's
  [DefaultValue(typeof(ulong), "...")] on 64-bit fields. Off, the attribute carries no value; the
  fields have ShouldSerialize methods, which protobuf-net uses instead of a default.
  _DefaultValueAttributeSupport is the SDK's internal property for the switch; if it ever goes, the
  warning comes back and fails the build.
  -->
  <PropertyGroup>
    <_DefaultValueAttributeSupport>false</_DefaultValueAttributeSupport>
  </PropertyGroup>

  <Target Name="PaneportListProtobufWarnings" BeforeTargets="_ComputeManagedAssemblyToLink">
    <ItemGroup>
      <ResolvedFileToPublish Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'protobuf-net.dll' Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'protobuf-net.Core.dll'">
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
  SteamKit2 picks its machine-information provider at run time with RuntimeInformation.IsOSPlatform,
  which the trimmer cannot decide, so it keeps the provider for macOS even when the app gives
  SteamKit2 a provider of its own, as the test flavor does. That provider's P/Invokes name
  DiskArbitration, a framework that only macOS has. .NET for iOS links every framework that a kept
  P/Invoke names unless its own table marks the framework unavailable, and the table does not know
  DiskArbitration, so the native link failed: "ld: framework 'DiskArbitration' not found". On iOS
  the P/Invokes of an assembly outside the SDK are looked up at run time (dlsym), so no symbol needs
  the framework when the app is linked, and the provider never runs on iOS. SteamKit2 itself stays
  unchanged. _NativeExecutableFrameworks is the internal item that the native link takes its
  frameworks from, the one .NET for iOS removes BrowserEngineKit from; if the item ever goes, the
  link fails again with the same error.
  -->
  <Target Name="PaneportDropDiskArbitration" AfterTargets="_ComputeLinkNativeExecutableInputs">
    <ItemGroup>
      <_NativeExecutableFrameworks Remove="DiskArbitration" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../Paneport.Core/Paneport.Core.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../Paneport.Steam/Paneport.Steam.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../Paneport.UI/Paneport.UI.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../Paneport.Interop/Paneport.Interop.csproj" />
  </ItemGroup>
</Project>
