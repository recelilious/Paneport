<Project Sdk="Microsoft.NET.Sdk">
  <!--
  The iOS app head (C-0004 section 2), the main app. Its build lives in AppHead.props, which the
  device test flavor in tests/device imports too. Building it needs a Mac with the pinned Xcode
  and the iOS workload, which eng/mac/bootstrap.sh installs, so eng/ci.slnf leaves it out
  (C-0011 section 4). docs/design/ios-app-head.md describes it.
  -->
  <PropertyGroup>
    <!-- The naming rule of C-0010 section 2 wants PascalCase, which .NET spells IOS, as in
         OperatingSystem.IsIOS. The project and its assembly keep the component's name. -->
    <RootNamespace>Paneport.IOS</RootNamespace>
  </PropertyGroup>

  <Import Project="AppHead.props" />
</Project>
