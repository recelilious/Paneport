<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Paneport.Core\Paneport.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ProjectReferences.cs" Link="Shared\ProjectReferences.cs" />
    <Compile Include="..\Shared\Fakes\*.cs" LinkBase="Shared\Fakes" />
  </ItemGroup>

  <!--
  The compatibility tests read their fixtures, the title schema, every file in compat/titles/ and
  the target devices of docs/design/compat-db.md. The README goes along, so that the folder of
  repository titles exists even while it holds no title file.
  -->
  <ItemGroup>
    <None Update="Compat\Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\compat\schema\title.schema.json" Link="Repository\compat\schema\title.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\compat\titles\*.json;..\..\compat\titles\README.md" LinkBase="Repository\compat\titles" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\design\compat-db.md" Link="Repository\docs\design\compat-db.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
